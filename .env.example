# Public deployment example
MDVR_OBSIDIAN_VAULT=./vaults/obsidian
# Optional extra vault mounts. Uncomment matching volume lines in compose.
# MDVR_WORK_VAULT=./vaults/work
# MDVR_ARCHIVE_VAULT=./vaults/archive

# nginx Basic Auth is enabled by default.
# Change the password before exposing mdvr outside a trusted local machine.
MDVR_AUTH_ENABLED=1
MDVR_AUTH_USER=mdvr
MDVR_AUTH_PASSWORD=change-me
MDVR_AUTH_REALM=MDVR
MDVR_AUTH_FILE=/run/mdvr.htpasswd

# mdvr discovers direct child directories under these container roots.
MDVR_VAULT_ROOTS=/vaults

# Set to 1 only for local development/test images.
MDVR_INSTALL_DEV_DEPS=0
